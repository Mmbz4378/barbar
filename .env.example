# ═══════════════════════════════════════════════════════════════════
# رشن — تنظیمات محیط
#
# این فایل نمونه است. نصاب (public/install.php) نسخهٔ واقعی `.env` را
# می‌سازد و APP_KEY را خودش تولید می‌کند.
#
# پس از نصب، برای هر تغییری همین `.env` را از File Manager ویرایش کنید.
# ═══════════════════════════════════════════════════════════════════

APP_NAME=رشن
APP_ENV=production
APP_DEBUG=false

# کلید رمزنگاری — نصاب می‌سازدش. دستی عوضش نکنید؛ نشست‌های باز و
# توکن کرون به آن بسته‌اند.
APP_KEY=

# آدرس کامل سایت، بدون اسلش آخر.
# اگر غلط باشد، لینک داخل QR و پیامک‌ها به جای اشتباه می‌برد.
APP_URL=https://example.com

APP_TIMEZONE=Asia/Tehran
SESSION_NAME=reshen_session

# پشت CDN/پروکسی (مثل Cloudflare)؟ true کنید تا IP واقعی از سرآیند خوانده شود؛
# وگرنه همه یک IP به نظر می‌رسند و سقف ورود با کد برای همه با هم پر می‌شود.
# بدون پروکسی false بماند (سرآیندها جعل‌شدنی‌اند).
# TRUST_PROXY=false

# ─── دیتابیس ───────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# سقف انتظار برای قفل ردیف (ثانیه). پیش‌فرض MySQL پنجاه است؛ زیر هجوم کمتر بهتر است.
# DB_LOCK_WAIT_TIMEOUT=5
# اتصال ماندگار به دیتابیس — پیش‌فرض خاموش؛ روی cPanel با سقف اتصال می‌تواند ضرر کند (docs/performance.md)
# DB_PERSISTENT=false

# ─── پیامک ─────────────────────────────────────────────────────────
# از نسخهٔ ۱۵ همهٔ این‌ها از «پنل مدیریت ← تنظیمات ← پیامک» هم تنظیم می‌شوند و
# مقدار پنل بر این فایل مقدم است؛ فیلدی که در پنل خالی است از این‌جا خوانده می‌شود.
# log      = هیچ پیامکی نمی‌رود، فقط در storage/logs/sms.log نوشته
#            می‌شود. برای توسعه.
# melipayamak / kavenegar = واقعی
SMS_DRIVER=log
# فقط توسعه/آزمون بار: تأخیر ساختگی هر پیامک در درایور log (میلی‌ثانیه)
# SMS_LOG_DELAY_MS=0

# سقف‌های ضدسوءاستفاده. اینترنت موبایل (CGNAT) کاربران زیادی را پشت یک IP می‌گذارد؛
# سقف هر شماره سخت است و سقف IP عمداً بالاتر (docs/performance.md).
# OTP_HOURLY_LIMIT_IP=200
# OTP_BURST_PER_IP=60
# BOOKING_MAX_PER_IP_PER_HOUR=30

SMS_MELIPAYAMAK_USERNAME=
SMS_MELIPAYAMAK_PASSWORD=
SMS_MELIPAYAMAK_SENDER=

# کاوه‌نگار اگر پر شود، خودکار پشتیبان می‌شود
SMS_KAVENEGAR_API_KEY=

# ─── الگوهای پیامک ─────────────────────────────────────────────────
# روی خط خدماتی (۳۰۰۰، ۲۰۰۰، ۹۸۲۱) اپراتور پیامکِ متنِ آزاد را تحویل
# نمی‌دهد ولی «ارسال شد» می‌خورد و پول هم کم می‌شود.
#
# متن دقیق هر الگو در پنل → «الگوی پیامک» هست، آمادهٔ کپی کردن در پنل
# اپراتور. الگویی که شناسه نداشته باشد، فرستاده نمی‌شود.
SMS_PATTERN_MELIPAYAMAK_OTP=
SMS_PATTERN_MELIPAYAMAK_BOOKING_CONFIRMED=
SMS_PATTERN_MELIPAYAMAK_BOOKING_CANCELLED=
SMS_PATTERN_MELIPAYAMAK_REMINDER_24H=
SMS_PATTERN_MELIPAYAMAK_REMINDER_2H=
SMS_PATTERN_MELIPAYAMAK_QUEUE_CHAIR_READY=
SMS_PATTERN_MELIPAYAMAK_QUEUE_NEARLY_UP=
SMS_PATTERN_MELIPAYAMAK_QUEUE_DELAYED=

SMS_PATTERN_KAVENEGAR_OTP=
SMS_PATTERN_KAVENEGAR_BOOKING_CONFIRMED=
SMS_PATTERN_KAVENEGAR_BOOKING_CANCELLED=
SMS_PATTERN_KAVENEGAR_REMINDER_24H=
SMS_PATTERN_KAVENEGAR_REMINDER_2H=
SMS_PATTERN_KAVENEGAR_QUEUE_CHAIR_READY=
SMS_PATTERN_KAVENEGAR_QUEUE_NEARLY_UP=
SMS_PATTERN_KAVENEGAR_QUEUE_DELAYED=

# خط اختصاصی دارید؟ آن‌وقت متنِ آزاد هم تحویل می‌شود و الگوی جانیفتاده
# با متن کامل می‌رود. روی خط خدماتی این را روشن نکنید.
SMS_DEDICATED_LINE=false

# کیف پیامک فعلاً اعمال نمی‌شود — پلتفرم رایگان است.
SMS_ENFORCE_CREDIT=false

# ─── رزرو ──────────────────────────────────────────────────────────
# تأیید شمارهٔ مشتری با کد پیامکی.
#
# پیش‌فرض خاموش است و عمدی: هر گام اضافه بخشی از مشتری‌ها را می‌ریزد،
# و مشتری به دادهٔ حساسی دسترسی پیدا نمی‌کند. جای آن را محدودیت نرخ
# می‌گیرد.
#
# توجه: این فقط برای **مشتری** است. ورود کارکنان به پنل با کد پیامکی یا
# نام کاربری و رمز است (روش‌ها: پنل مدیریت ← تنظیمات ← ورود و ثبت‌نام)؛
# لینک یک‌بارمصرف اضطراری: php tools/login-link.php 09xxxxxxxxx
BOOKING_VERIFY_PHONE=false

# ─── پرداخت آنلاین ─────────────────────────────────────────────────
# از نسخهٔ ۱۵ از «پنل مدیریت ← تنظیمات ← پرداخت» هم تنظیم می‌شود (مقدم بر این‌جا).
# disabled = خاموش (پیش‌فرض؛ پلتفرم رایگان است)
# zarinpal = روشن
PAYMENT_DRIVER=disabled
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ─── ظاهر ──────────────────────────────────────────────────────────
# iranyekan پیش‌فرض؛ چهار وزن محلی IRANYekanX همراه این خروجی قرار دارند.
# vazirmatn نیز قابل انتخاب است. راهنمای فونت در public/assets/fonts/README.md است.
UI_FONT=iranyekan

# Public discovery maps (loaded only when requested)
MAPS_ENABLED=true
# Online payment stays disabled until configured and reviewed

# ───────────────────────────────────────────────────────────────────
# به‌روزرسانی خودکار — راهنما: docs/updates.md
# حالت کار و بازهٔ شبانه را از «به‌روزرسانی سامانه» در پنل هم می‌شود عوض کرد.
# ───────────────────────────────────────────────────────────────────
UPDATE_SOURCE=github
UPDATE_GITHUB_REPO=Mmbz4378/barbar
# فقط اگر مخزن خصوصی شد: توکن fine-grained با دسترسی Contents: Read
UPDATE_GITHUB_TOKEN=
UPDATE_CHANNEL=stable
# off = خاموش، notify = فقط اعلام، auto = نصب خودکار در بازهٔ شبانه
UPDATE_MODE=auto
UPDATE_WINDOW_START=3
UPDATE_WINDOW_END=5
# کلید عمومی امضای انتشار (اختیاری ولی توصیه‌شده)؛ با tools/release-keygen.php بسازید
UPDATE_PUBLIC_KEY=
